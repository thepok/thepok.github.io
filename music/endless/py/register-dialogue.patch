+def _register_dialogue(plan: list, seed: int, meter: int = 4, strategy: str = 'statement', avoid=None) -> list:
+    """A return or contrasting section changes role by a complete phrase; the first theme and peak stay intact.
+
+    Strategy is pinned across a set's best-of-N candidates. A lyrical piece changes
+    accompaniment density instead of forcing the same low return into every tune.
+    """
+    if strategy not in ('statement', 'answer', 'lyrical'):
+        raise ValueError(f'unknown register texture: {strategy!r}')
+    rng = random.Random(f'register-dialogue:{seed}')
+    candidates = [i for i, (sec, _, mel, _) in enumerate(plan)
+                  if sec['name'] in ('A2', 'A3', 'A4', 'B1') and mel and not sec.get('peak')
+                  and sec['name'] != avoid and not sec.get('_sig') and not sec.get('_anthem')]
+    if not candidates:
+        return plan
+    result = list(plan)
+    if strategy == 'lyrical':
+        i = rng.choice(candidates)
+        sec, ch, mel, length = result[i]
+        result[i] = (dict(sec, _lyrical=True), ch, mel, length)
+        return result
+    unit = (8 if meter == 3 else 4) * meter
+    choices = []
+    for i in candidates:
+        sec, _, mel, length = plan[i]
+        spans = ([(0, length)] if strategy == 'statement' else
+                 [(t, t + unit) for t in range(unit, int(length), unit)
+                  if t + unit <= length])
+        if strategy == 'answer' and not spans and length > unit:
+            spans = [(0, unit)]  # a complete returning phrase answers the earlier statement
+        for a, z in spans:
+            phrase = [p for t, _, p in mel if a <= t < z]
+            if phrase and min(phrase) >= 65:
+                choices.append((i, a, z))
+    if not choices:
+        # A low-lying tune still receives a meaningful texture contrast safely.
+        return _register_dialogue(plan, seed, meter, 'lyrical', avoid)
+    i, a, z = rng.choice(choices)
+    sec, ch, mel, length = result[i]
+    result[i] = (dict(sec, _tenor=(a, z)), ch,
+                 [(t, d, p - 12 if a <= t < z else p) for t, d, p in mel], length)
+    return result
+
+
+def _register_breath(notes, plan, secs, meter):
+    """Retain written phrase breaths when register-dependent humanization erodes them.
+
+    Only near-downbeat attacks in lowered phrases may move, at most 0.12 beat,
+    retaining their original releases. Never create a rest the written melody lacks.
+    """
+    out = list(notes)
+    unit = (8 if meter == 3 else 4) * meter
+    for sec, _, mel, length in plan:
+        if not sec.get('_tenor'):
+            continue
+        a, z = sec['_tenor']
+        start = secs[sec['name']].start
+        for boundary in range(unit, int(length), unit):
+            if not a < boundary < z:
+                continue
+            before = [t for t, _, _ in mel if boundary - 2 * meter <= t < boundary - .15]
+            after = [t for t, _, _ in mel if t >= boundary - .15]
+            if not before or not after or min(after) - max(before) < 1.0 - 1e-6:
+                continue
+            beat = start + boundary
+            prior = [n.start for n in out if beat - 2 * meter <= n.start < beat - .15]
+            later = [n.start for n in out if beat - .15 <= n.start < beat + .15]
+            if not prior or not later:
+                continue
+            onset = min(later)
+            gap = onset - max(prior)
+            if .93 <= gap < 1.05:
+                shift = 1.05 - gap
+                out = [n._replace(start=n.start + shift, dur=max(.05, n.dur - shift))
+                       if abs(n.start - onset) < .03 else n for n in out]
+    return out
+
+
+def _register_answer_figure(meter: int, span: float) -> str:
+    """One upper response inside the actual harmonic span, including short changes.
+
+    figure() uses a whole-bar token grid even when span is shorter. Put the note
+    halfway through the available span on its eighth-note grid, never at/after its end.
+    """
+    toks = ['-'] * (2 * meter)
+    at = min(len(toks) - 1, max(0, int(span)))  # half a span in half-beat tokens
+    while at * 0.5 >= span and at:
+        at -= 1
+    toks[at] = '0'
+    return ' '.join(toks)
+
