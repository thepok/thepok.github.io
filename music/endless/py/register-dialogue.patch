+def _register_locality(reference: Song, candidate: Song) -> Song:
+    """Replace only intended attacks, retaining the reference performance elsewhere.
+
+    Timing belongs to the attack (including a 0.15-beat anticipated downbeat), not
+    the release: a note crossing a seam keeps its full duration. Compile-time body
+    noise is materialized too, since changing note count otherwise redraws later
+    phrases. The cache is used only while the built song's performance is unedited.
+    """
+    from types import MethodType
+    spans = {'piano': [], 'comp': []}
+    for name, tenor, lyrical in candidate.endless_register_spans:
+        sec = reference[name]
+        if tenor:
+            for hand in spans:
+                spans[hand].append((sec.start + tenor[0], sec.start + tenor[1]))
+        elif lyrical:
+            spans['comp'].append((sec.start, sec.end))
+
+    def inside(note, windows):
+        return any(a - .15 <= note.start < z - .15 for a, z in windows)
+
+    length = reference.length
+    tempo_map = reference.tempo_map()
+    bpm = tempo_map.bpm_at
+    tempo_points = tuple(map(tuple, tempo_map.points))
+    cache, prepared = {}, {}
+    # Both hands must be evaluated before either changes: the left hand follows
+    # the right hand's body, so evaluating it after the splice would redraw it.
+    for hand in spans:
+        original, changed = reference.tracks[hand], candidate.tracks[hand]
+        prepared[hand] = (list(Clip._raw(original._notes, length)),
+                          list(Clip._raw(changed._notes, length)),
+                          *reference._played(original, length, bpm),
+                          *candidate._played(changed, length, bpm))
+    for hand, windows in spans.items():
+        original, changed = reference.tracks[hand], candidate.tracks[hand]
+        raw0, raw1, written0, played0, written1, played1 = prepared[hand]
+        # The piano's body path supplies aligned lists. Do not silently truncate if
+        # another performer later changes that contract.
+        if not len(raw0) == len(written0) == len(played0) or not len(raw1) == len(written1) == len(played1):
+            raise ValueError('register locality requires aligned written/played piano notes')
+        rows = [(r, w, n) for r, w, n in zip(raw0, written0, played0) if not inside(r, windows)]
+        rows += [(r, w, n) for r, w, n in zip(raw1, written1, played1) if inside(r, windows)]
+        rows.sort(key=lambda x: (x[0].start, x[0].pitch))
+        origins = {id(n): o for track in (original, changed) for n, o in zip(track._notes, track._origin)}
+        original._notes = [r for r, _, _ in rows]
+        original._origin = [origins.get(id(r), '') for r, _, _ in rows]
+        cache[hand] = ([w for _, w, _ in rows], [n for _, _, n in rows])
+    reference.__dict__.pop('_motions', None)
+
+    def fingerprint(song):
+        return (song.tempo, song.key, song.seed, song.length, song.meter,
+                repr(vars(song._tempo_plan)),
+                tuple((sec.name, sec.start, sec.end) for sec in song.sections),
+                tuple((key, repr(t._notes), repr(t._human), repr(t._body), repr(t._groove),
+                       tuple(t._phrase_marks)) for key, t in song.tracks.items()))
+
+    state = fingerprint(reference)
+    ordinary = type(reference)._played
+
+    def played(self, track, L, bpm):
+        owner = getattr(bpm, '__self__', None)
+        same_tempo = (getattr(bpm, '__func__', None) is type(tempo_map).bpm_at and
+                      tuple(map(tuple, owner.points)) == tempo_points) if owner is not None else \
+                     isinstance(bpm, (int, float)) and all(v == bpm for _, v in tempo_points)
+        if track.id in cache and L == length and same_tempo and fingerprint(self) == state:
+            w, ns = cache[track.id]
+            return list(w), list(ns)
+        self.__dict__.pop('_motions', None)
+        return ordinary(self, track, L, bpm)
+
+    reference._played = MethodType(played, reference)
+    for key in ('endless_register_texture', 'endless_register_effective', 'endless_register_spans',
+                'endless_tenor', 'endless_arrangement'):
+        setattr(reference, key, getattr(candidate, key))
+    reference.endless_lh_limits = ([row for row in reference.endless_lh_limits
+                                    if not any(a - .15 <= row[0] < z for a, z in spans['comp'])] +
+                                   [row for row in candidate.endless_lh_limits
+                                    if any(a - .15 <= row[0] < z for a, z in spans['comp'])])
+    # Keep original per-section diagnostics except sections whose accompaniment changed.
+    names = {name for name, _, _ in candidate.endless_register_spans}
+    for attr in ('endless_figures', 'endless_lh'):
+        original, changed = getattr(reference, attr), getattr(candidate, attr)
+        setattr(reference, attr, {k: changed[k] if k in names else v for k, v in original.items()})
+    reference.endless_register_locality = {'attack_tolerance': .15, 'spans': spans}
+    return reference
+
